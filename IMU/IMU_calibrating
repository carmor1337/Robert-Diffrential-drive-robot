            #print(split)
            if len(split) < 6 or not split[3].replace('.', '', 1).replace('-', '', 1).isdigit():
                continue  # skip invalid lines (e.g., header)
            """ accel_measurments[0].append(float(split[0]))
            accel_measurments[1].append(float(split[1]))
            accel_measurments[2].append(float(split[2]))"""
            accel = [float(split[0]), float(split[1]), float(split[2])]
            accel_measurments.append(accel)
    
    return np.array(accel_measurments) # shape: (N, 3)

def calibrate_accelerometer():
    accel_data = get_accel_data()  # shape: (N, 3)
    def residuals(params):
        # Extract bias (3), and calibration matrix (9 values)
        b = np.array(params[0:3])
        M = np.array(params[3:]).reshape((3, 3))
        #print(b)
        #print(M)
        corrected = np.dot(accel_data - b, M.T)
        magnitudes = np.linalg.norm(corrected, axis=1)
        return magnitudes - 9.81  # assuming SI units

    # Initial guess: zero bias, identity matrix
    x0 = np.zeros(3 + 9)
    x0[3] = x0[7] = x0[11] = 1.0  # diagonal of identity matrix
    
    result = least_squares(residuals, x0)

    b_opt = result.x[0:3]
    M_opt = result.x[3:].reshape((3, 3))
    return b_opt, M_opt
    


def process_accelerometer_data():
    raw_accel_data = get_accel_data()
    bias,matrix = calibrate_accelerometer()
    #raw = np.array(raw)
